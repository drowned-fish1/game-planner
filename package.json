{
  "name": "game-planner",
  "private": true,
  "version": "0.2.0",
  "description": "Game Planner Pro · 游戏策划工作台：白板、文档、团队待办、UI 原型与局域网协作",
  "author": "Game Planner Pro Team",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "icon:generate": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "build": "tsc && vite build",
    "electron:build": "npm run icon:generate && npm run build && electron-builder",
    "android:sync": "npm run icon:generate && npm run build && npx cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "node --test --test-concurrency=1",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath .githooks || echo skip-hooks"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@tiptap/extension-bubble-menu": "^2.2.4",
    "@tiptap/extension-placeholder": "^2.2.4",
    "@tiptap/pm": "^2.2.4",
    "@tiptap/react": "^2.2.4",
    "@tiptap/starter-kit": "^2.2.4",
    "@xyflow/react": "^12.0.0",
    "electron-squirrel-startup": "^1.0.0",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.6",
    "react-resizable": "^3.0.5",
    "react-xarrows": "^2.0.2",
    "react-zoom-pan-pinch": "^3.7.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.1",
    "@tailwindcss/typography": "^0.5.10",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/react-resizable": "^3.0.4",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.gameplanner.app",
    "productName": "Game Planner Pro",
    "copyright": "Copyright © 2024-2026 Game Planner Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon.ico",
      "public/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
