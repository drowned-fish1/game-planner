#!/bin/sh
# 提交前质量门禁：类型检查 + ESLint
# 通过 package.json 的 prepare 脚本自动启用（git config core.hooksPath .githooks）

echo "[pre-commit] tsc --noEmit ..."
npx tsc --noEmit || exit 1

echo "[pre-commit] eslint ..."
npm run --silent lint || exit 1

echo "[pre-commit] unit tests ..."
npm run --silent test || exit 1

echo "[pre-commit] OK"
